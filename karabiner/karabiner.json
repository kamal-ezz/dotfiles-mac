{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Shift+Option toggles between ABC and Arabic",
                        "manipulators": [
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^en$" }] }],
                                "from": { "key_code": "left_shift", "modifiers": { "mandatory": ["option"] } },
                                "to": [{ "key_code": "left_shift" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Arabic$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^ar$" }] }],
                                "from": { "key_code": "left_shift", "modifiers": { "mandatory": ["option"] } },
                                "to": [{ "key_code": "left_shift" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^en$" }] }],
                                "from": { "key_code": "right_shift", "modifiers": { "mandatory": ["option"] } },
                                "to": [{ "key_code": "right_shift" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Arabic$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^ar$" }] }],
                                "from": { "key_code": "right_shift", "modifiers": { "mandatory": ["option"] } },
                                "to": [{ "key_code": "right_shift" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^en$" }] }],
                                "from": { "key_code": "left_option", "modifiers": { "mandatory": ["shift"] } },
                                "to": [{ "key_code": "left_option" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Arabic$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^ar$" }] }],
                                "from": { "key_code": "left_option", "modifiers": { "mandatory": ["shift"] } },
                                "to": [{ "key_code": "left_option" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^en$" }] }],
                                "from": { "key_code": "right_option", "modifiers": { "mandatory": ["shift"] } },
                                "to": [{ "key_code": "right_option" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Arabic$" } }]
                            },
                            {
                                "type": "basic",
                                "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "^ar$" }] }],
                                "from": { "key_code": "right_option", "modifiers": { "mandatory": ["shift"] } },
                                "to": [{ "key_code": "right_option" }],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } }]
                            }
                        ]
                    },
                    {
                        "description": "Launch Kitty",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["option"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "/usr/bin/open -a 'kitty'"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
