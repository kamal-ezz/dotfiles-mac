# Shared CLI git diff styling; theme colors come from bin/theme.
# Personal settings (user.name, user.email, includeIf, ...) stay in ~/.gitconfig.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	line-numbers = true

[include]
	path = ../dotfiles-theme/delta.gitconfig
